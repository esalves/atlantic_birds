*.zip
Analysis/*.zip

# Knitr/Rmarkdown cache and files
*_cache/
*_files/

# Downloaded PREDICTS data cache
*predicts_extract.rds*
.venv-massreport/

/.quarto/
**/*.quarto_ipynb

Analysis/data/raw/worldclim/*.zip

# smoke-test model objects (wiring checks only, never results)
*smoke*.rda
*_SMOKE*.rds

# Quarto render side-effects (the manuscript build lives in Manuscript/_manuscript/)
Manuscript/index-preview.html
Manuscript/index.embed.ipynb
Manuscript/index.out.ipynb
Manuscript/index.html

dist/

# Bayesian (Stan) tier: per-tree posterior fits (~400 MB), exported job files
# (model frames, regenerated by PHYLO_EXPORT_DIR runs) and the compiled model.
# Only the pooled summary (BAYES_SUMMARY.md, bayes_summary.rds) is tracked.
Analysis/output/bayes/fits/
Analysis/output/bayes/jobs/
# superseded per-tree fits kept for reference (e.g. trees refitted with longer chains)
Analysis/output/bayes_old/
Analysis/scripts/stan/*.rds
