@article{teplitsky_bergmanns_2008,
	title = {Bergmann's rule and climate change revisited: {Disentangling} environmental and genetic responses in a wild bird population},
	volume = {105},
	copyright = {© 2008 by The National Academy of Sciences of the USA},
	issn = {0027-8424, 1091-6490},
	shorttitle = {Bergmann's rule and climate change revisited},
	url = {https://www.pnas.org/content/105/36/13492},
	doi = {10.1073/pnas.0800999105},
	abstract = {Ecological responses to on-going climate change are numerous, diverse, and taxonomically widespread. However, with one exception, the relative roles of phenotypic plasticity and microevolution as mechanisms in explaining these responses are largely unknown. Several recent studies have uncovered evidence for temporal declines in mean body sizes of birds and mammals, and these responses have been interpreted as evidence for microevolution in the context of Bergmann's rule—an ecogeographic rule predicting an inverse correlation between temperature and mean body size in endothermic animals. We used a dataset of individually marked red-billed gulls (Larus novaehollandiae scopulinus) from New Zealand to document phenotypic and genetic changes in mean body mass over a 47-year (1958–2004) period. We found that, whereas the mean body mass had decreased over time as ambient temperatures increased, analyses of breeding values estimated with an “animal model” approach showed no evidence for any genetic change. These results indicate that the frequently observed climate-change-related responses in mean body size of animal populations might be due to phenotypic plasticity, rather than to genetic microevolutionary responses.},
	language = {en},
	number = {36},
	urldate = {2019-06-14},
	journal = {Proceedings of the National Academy of Sciences},
	author = {Teplitsky, Céline and Mills, James A. and Alho, Jussi S. and Yarrall, John W. and Merilä, Juha},
	month = sep,
	year = {2008},
	pmid = {18757740},
	keywords = {adaptation, animal model, quantitative genetics},
	pages = {13492--13496},
	file = {Full Text PDF:/Users/eduardosantos1/Zotero/storage/MEYPEFMU/Teplitsky et al. - 2008 - Bergmann's rule and climate change revisited Dise.pdf:application/pdf;Snapshot:/Users/eduardosantos1/Zotero/storage/AFI8M8JS/13492.html:text/html}
}


@article{rode_reduced_2010,
	title = {Reduced body size and cub recruitment in polar bears associated with sea ice decline},
	volume = {20},
	copyright = {© 2010 by the Ecological Society of America},
	issn = {1939-5582},
	url = {https://esajournals.onlinelibrary.wiley.com/doi/abs/10.1890/08-1036.1},
	doi = {10.1890/08-1036.1},
	abstract = {Rates of reproduction and survival are dependent upon adequate body size and condition of individuals. Declines in size and condition have provided early indicators of population decline in polar bears (Ursus maritimus) near the southern extreme of their range. We tested whether patterns in body size, condition, and cub recruitment of polar bears in the southern Beaufort Sea of Alaska were related to the availability of preferred sea ice habitats and whether these measures and habitat availability exhibited trends over time, between 1982 and 2006. The mean skull size and body length of all polar bears over three years of age declined over time, corresponding with long-term declines in the spatial and temporal availability of sea ice habitat. Body size of young, growing bears declined over time and was smaller after years when sea ice availability was reduced. Reduced litter mass and numbers of yearlings per female following years with lower availability of optimal sea ice habitat, suggest reduced reproductive output and juvenile survival. These results, based on analysis of a long-term data set, suggest that declining sea ice is associated with nutritional limitations that reduced body size and reproduction in this population.},
	language = {en},
	number = {3},
	urldate = {2019-06-14},
	journal = {Ecological Applications},
	author = {Rode, Karyn D. and Amstrup, Steven C. and Regehr, Eric V.},
	year = {2010},
	keywords = {Alaska, body size, climate, condition, habitat, morphometrics, polar bears, sea ice, southern Beaufort Sea, Ursus maritimus., USA},
	pages = {768--782},
	file = {Snapshot:/Users/eduardosantos1/Zotero/storage/BRIQDETG/08-1036.html:text/html}
}

